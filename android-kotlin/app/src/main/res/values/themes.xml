<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind Compose. Dark so launching never flashes
         white before the first frame, and no action bar because every
         screen draws its own header. -->
    <style name="Theme.Playthruu" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
