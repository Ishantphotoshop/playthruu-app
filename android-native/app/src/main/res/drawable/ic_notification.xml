<?xml version="1.0" encoding="utf-8"?>
<!-- The status-bar icon. Android draws these as a silhouette — it keeps
     the alpha channel and throws the colour away — so this is the mark
     alone at 24dp, solid white, with no background. Using the launcher
     icon here instead would render as a white-filled square.

     Same geometry as the mark, scaled from its 120-unit square into 24:
     24 / 120 = 0.2, then inset slightly (0.175) and centred so the glyph
     has the small margin the status bar expects. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <group
        android:scaleX="0.175"
        android:scaleY="0.175"
        android:translateX="1.5"
        android:translateY="1.5">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 110,52.5 L 60,52.5 A 7.5,7.5 0 0,0 60,67.5 L 110,67.5 A 2.9272,2.9272 0 0,1 112.8625,71.0248 A 54,54 0 1,1 112.8625,48.9752 A 2.9272,2.9272 0 0,1 110,52.5 Z" />
    </group>
</vector>
