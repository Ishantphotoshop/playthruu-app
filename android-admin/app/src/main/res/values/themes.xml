<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No action bar (the web app draws its own header) and a dark
         window background, so launching doesn't flash white before the
         WebView paints. Light status-bar icons because the ground behind
         them is near-black. -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
