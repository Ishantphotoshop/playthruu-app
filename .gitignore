# Android build output and machine-specific / secret build config.
# The site itself is served straight from this repo by GitHub Pages, so
# only the Android shell in android-admin/ has anything to ignore.
android-admin/.gradle/
android-admin/build/
android-admin/app/build/
android-admin/local.properties
android-admin/keystore.properties
android-admin/*.jks
android-admin/*.keystore

# The native APK's bundled copy of the site is BUILD OUTPUT — regenerate
# it with scripts/bundle-native.py. Committing it would put a second copy
# of every file in the repo, free to drift from the real one.
android-native/app/src/main/assets/www/

android-native/.gradle/
android-native/build/
android-native/app/build/
android-native/local.properties
android-native/keystore.properties
android-native/*.jks
android-native/*.keystore

android-app/.gradle/
android-app/build/
android-app/app/build/
android-app/local.properties
android-app/keystore.properties
android-app/*.jks
android-app/*.keystore

# Supabase CLI scratch state
supabase/.temp/
