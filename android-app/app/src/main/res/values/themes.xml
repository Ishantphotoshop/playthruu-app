<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No action bar (the site draws its own header) and a dark window
         background, so launching doesn't flash white. -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- The launcher itself paints nothing: it exists only long enough to
         hand off to Chrome, and Chrome draws the splash. A translucent
         window means there is no extra frame of app background appearing
         and then being replaced. -->
    <style name="Theme.LauncherActivity" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
